<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.WorkOrder.search.mapper.TicketSearchWriteTargetMapper">
    <resultMap id="writeTargetRecord" type="com.WorkOrder.search.model.TicketSearchWriteTargetRecord">
        <id property="controlId" column="control_id"/>
        <result property="currentJobId" column="current_job_id"/>
        <result property="writeGeneration" column="write_generation"/>
        <result property="writeAlias" column="write_alias"/>
        <result property="phase" column="phase"/>
        <result property="jobId" column="job_id"/>
        <result property="jobGeneration" column="job_generation"/>
        <result property="jobWriteAlias" column="job_write_alias"/>
        <result property="targetIndex" column="target_index"/>
    </resultMap>

    <!-- LEFT JOIN 使缺少任务的控制记录仍可识别，不能静默回退到读别名。 -->
    <select id="selectCurrent" resultMap="writeTargetRecord" useCache="false" flushCache="true">
        SELECT control.id AS control_id, control.current_job_id, control.write_generation,
               control.write_alias, control.phase, job.id AS job_id,
               job.generation AS job_generation, job.write_alias AS job_write_alias,
               job.target_index
        FROM ticket_search_sync_state control
        LEFT JOIN ticket_search_import_jobs job ON job.id = control.current_job_id
        WHERE control.id = 1
    </select>
</mapper>
