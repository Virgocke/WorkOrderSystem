<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.WorkOrder.notification.mapper.NotificationMapper">
    <resultMap id="notification" type="com.WorkOrder.notification.model.Notifications">
        <id property="id" column="id"/>
        <result property="ticketId" column="ticket_id"/>
        <result property="ticketNo" column="ticket_no"/>
        <result property="receiverId" column="receiver_id"/>
        <result property="channel" column="channel"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 列表筛选和未读数量共用阅读状态映射。 -->
    <sql id="readingStatus">
        CASE WHEN n.status = 'READ' THEN 'READ' ELSE 'UNREAD' END
    </sql>

    <select id="selectMyNotifications" resultMap="notification">
        SELECT n.id, n.ticket_id, t.ticket_no, n.receiver_id,
               n.channel, n.content, n.status, n.created_at
        FROM notification_records n
        LEFT JOIN tickets t ON t.id = n.ticket_id
        WHERE n.receiver_id = #{receiverId} AND n.channel = 'INTERNAL'
        <if test="status != null and status != ''">
            <!-- 将数据库投递状态映射为文档约定的阅读状态后筛选。 -->
            AND <include refid="readingStatus"/> = #{status}
        </if>
        ORDER BY n.created_at DESC, n.id DESC
    </select>

    <select id="countUnreadNotifications" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM notification_records n
        WHERE n.receiver_id = #{receiverId} AND n.channel = 'INTERNAL'
          AND <include refid="readingStatus"/> = 'UNREAD'
    </select>
</mapper>
